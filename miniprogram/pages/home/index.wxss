/* ---------- 管理员 ---------- */
.admin-card { position: relative; padding: 32rpx 0 24rpx; }
.admin-tag {
  position: absolute;
  right: 24rpx;
  top: 20rpx;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  background: #F3F0FF;
  color: #7C5CFF;
  font-size: 22rpx;
  line-height: 40rpx;
}
/* 职位头衔三色分层（超管金 / 班委蓝 / 辅导员青） */
.admin-tag.super { color: #D46B08; background: #FFF3C2; }
.admin-tag.committee { color: #3370FF; background: #F0F5FF; }
.admin-tag.counselor { color: #0AA5A8; background: #E8FFFB; }
.admin-grid { display: flex; flex-direction: row; }
.admin-cell {
  flex: 1;
  height: 144rpx;
  margin: 0 12rpx;
  background: #F7F8FA;
  border-radius: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.admin-cell text { margin-top: 12rpx; font-size: 26rpx; color: #1D2129; }
.admin-cell:active { background: #F0F5FF; }

/* ---------- 提醒卡 · 测试提醒入口（开启后出现；点击发一条测试订阅消息并弹窗回访） ---------- */
.remind-test { margin-top: 8rpx; font-size: 24rpx; color: #3370FF; }
.remind-test.busy { opacity: 0.5; }

/* ---------- 查看通知（§41 需求⑦）全员可见 ---------- */
.notice-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 32rpx;
}
.notice-card:active { background: #F2F3F5; }
.notice-info { flex: 1; margin-left: 24rpx; }
.notice-title { font-size: 30rpx; color: #1D2129; }
.notice-sub { margin-top: 4rpx; font-size: 24rpx; color: #86909C; }
.notice-badge {
  flex-shrink: 0;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: #FFFFFF;
  background: #F53F3F;
  border-radius: 999rpx;
  margin-right: 12rpx;
}

/* ---------- 发布通知 · 金山文档链接预警 ---------- */
.np-link-hint { display: block; margin-top: 8rpx; font-size: 22rpx; line-height: 1.5; color: #D46B08; }

/* ---------- 发布通知 · 多班级选班（§43 需求⑥） ---------- */
.np-classes {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 4rpx;
}
.np-cls {
  margin: 0 12rpx 12rpx 0;
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #3370FF;
  background: #DCE8FF;
  border-radius: 999rpx;
}
/* ⚠️ .on 补的那点 padding 是「挤开动画」的另一半：
   app.wxss 的 .chip-motion 负责过渡 padding（邻项才会跟着让位），
   这里负责给出**变宽后的目标值**。只加 class 不给目标值 = 宽度没变 = 动画看不见。 */
.np-cls.on { color: #FFFFFF; background: #3370FF; padding: 0 34rpx; }
.np-cls.ghost { color: #4E5969; background: #F2F3F5; }
.np-cls-tip { display: block; margin-top: 8rpx; font-size: 22rpx; line-height: 32rpx; color: #86909C; }
/* 「按职位」预设职位：一键选择的圆角 chip（与 .np-cls 同刻度，蓝底浅色） */
.np-chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 4rpx;
}
.np-chip {
  margin: 0 12rpx 12rpx 0;
  padding: 0 22rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #3370FF;
  background: #DCE8FF;
  border-radius: 999rpx;
}
/* 同 .np-cls.on：变宽的目标值（0 22rpx → 0 32rpx） */
.np-chip.on { color: #FFFFFF; background: #3370FF; padding: 0 32rpx; }
.np-pos-tip { display: block; margin-top: 8rpx; font-size: 22rpx; line-height: 1.5; color: #86909C; }

/* ---------- 值日提醒 · 底部悬浮胶囊（§43 需求③） ----------
 * 原「提醒卡」占一整张卡片，位置在首页中部；改为悬浮在底部 tabBar 之上，
 * 不占正文高度。right 对齐页面 32rpx；bottom 让开自定义 tabBar（悬浮胶囊
 * 占位 98rpx）+ 安全区。 */
.remind-fab {
  position: fixed;
  right: 32rpx;
  /* 让开底部悬浮胶囊 tabBar（占位 98rpx）+ 安全区；无安全区机型（安卓）兜底 32px，
     与 iPhone 的底部留白观感一致（见 custom-tab-bar/index.js 的 TABBAR_LIFT_PX）。
     ⚠️ 必须保留前一行做回退：引擎不认 max() 时整条声明会被丢弃 → bottom 退回 auto。 */
  bottom: calc(122rpx + env(safe-area-inset-bottom));
  bottom: calc(122rpx + max(env(safe-area-inset-bottom), 32px));
  z-index: 20;
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 72rpx;
  padding: 0 26rpx;
  /* 悬浮胶囊 = 玻璃材质（v0.7.17）：原来是纯白实心 + 淡蓝描边，
     现在换成半透明底 + 背景模糊 + 亮边 —— 它浮在正文之上，背后有内容可模糊。 */
  background: rgba(255, 255, 255, 0.50);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  backdrop-filter: blur(24px) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: var(--r-pill, 999rpx);
  box-shadow: 0 6rpx 22rpx rgba(51,112,255,.18), inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .remind-fab { background: rgba(255, 255, 255, 0.93); }
}
@media (prefers-reduced-transparency: reduce) {
  .remind-fab {
    background: #FFFFFF;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
}
.remind-fab text { margin-left: 10rpx; font-size: 26rpx; font-weight: 600; color: #3370FF; }

/* ---------- 关注的学生（v0.7.17 需求⑥，仅辅导员 / 超管） ----------
 * 一行一位学生：头像 + （姓名 + 班级）+ 最新备注摘要 + 备注条数。
 * 备注摘要限一行省略号 —— 首页是「一眼找到人」，不是读备注的地方，
 * 完整内容点进成员详情看（那里版式也是为阅读设计的）。 */
.pin-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 28rpx;
}
/* 行间分割线用相邻兄弟（+）：第一行紧跟在 .card-head 的底边之后，不必再画一条 */
.pin-row + .pin-row { border-top: 2rpx solid rgba(242, 243, 245, 0.9); }
.pin-info {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.pin-line1 { display: flex; flex-direction: row; align-items: center; }
.pin-name { font-size: 30rpx; font-weight: 500; color: #1D2129; }
.pin-class {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 22rpx;
  color: #3370FF;
  background: #F0F5FF;
  border-radius: 16rpx;
}
.pin-note {
  font-size: 25rpx;
  color: #86909C;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.pin-cnt {
  flex: 0 0 auto;
  min-width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 8rpx;
  margin-right: 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: #4E5969;
  background: #F2F3F5;
  border-radius: 17rpx;
}
.pin-empty {
  padding: 44rpx 32rpx;
  text-align: center;
  font-size: 25rpx;
  line-height: 1.7;
  color: #86909C;
}

/* ---------- 更新公告（v0.7.25）：主页弹层 ---------- */
.an-view {
  padding: 24rpx 32rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}
.an-view-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 16rpx;
}
.an-view-scroll {
  max-height: 560rpx;
}
.an-view-content {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  color: #4E5969;
  white-space: pre-wrap;
  word-break: break-all;
}
.an-view-btn {
  margin-top: 32rpx;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, #EC4899, #8B5CF6);
}

/* ---------- 首页请假卡（1.0.5 追加，需求①②） ---------- */
.leave-home { display: flex; flex-direction: column; padding: 24rpx 32rpx; }
.lh-head { display: flex; align-items: baseline; justify-content: space-between; }
.lh-title { font-size: 30rpx; font-weight: 600; color: #1D2129; }
.lh-date { font-size: 22rpx; color: #86909C; }
.lh-body { display: flex; align-items: baseline; margin: 16rpx 0 12rpx; }
.lh-num { font-size: 64rpx; font-weight: 700; color: #1D2129; line-height: 1; }
.lh-num.warn { color: #D46B08; }
.lh-unit { margin-left: 12rpx; font-size: 26rpx; color: #4E5969; }
.lh-foot { display: flex; align-items: center; font-size: 24rpx; color: #86909C; }
.lh-grp { margin-right: 24rpx; }
.lh-more { margin-left: auto; color: #3370FF; }
.lh-classes { display: flex; flex-direction: column; margin-top: 12rpx; }
.lh-cls {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 0; border-bottom: 2rpx solid #EEF0F3;
}
.lh-cls:last-child { border-bottom: none; }
.lh-cls-name { font-size: 28rpx; color: #1D2129; }
.lh-cls-num { font-size: 28rpx; color: #D46B08; }
.lh-empty {
  padding: 20rpx 0; font-size: 24rpx; color: #86909C;
  text-align: center; background: #F7F8FA; border-radius: 24rpx;
}

/* ---------- 请假名单（首页查看弹层，与 roster 同视觉） ---------- */
.lv { padding: 8rpx 32rpx 40rpx; }
.lv-grp { margin-top: 16rpx; }
.lv-grp-t { display: block; margin-bottom: 8rpx; font-size: 26rpx; font-weight: 600; color: #1D2129; }
.lv-row { display: flex; align-items: center; padding: 16rpx 0; border-top: 2rpx solid #EEF0F3; }
.lv-row:first-of-type { border-top: none; }
.lv-info { flex: 1; min-width: 0; margin-left: 16rpx; display: flex; flex-direction: column; }
.lv-name { font-size: 28rpx; color: #1D2129; }
.lv-sub { margin-top: 4rpx; font-size: 22rpx; color: #86909C; }
.lv-cancel {
  flex-shrink: 0; padding: 0 24rpx; height: 56rpx; line-height: 56rpx;
  font-size: 24rpx; color: #D46B08; background: #FFF7E8; border-radius: 999rpx;
}
.lv-cancel:active { background: #FFEFD1; }
.lv-cancel.busy { opacity: .6; }
.lv-empty {
  padding: 28rpx 0; font-size: 24rpx; color: #86909C; text-align: center;
  background: #F7F8FA; border-radius: 24rpx;
}

/* ---------- 今日课次「已上完」灰化（2026-09-29 需求） ----------
 * 当前时间 ≥ 下课时间(periodTime.end)即整行变灰、降透明度；不论是否本人(isMine)课次都
 * 统一灰化，表达「这节课已经上完」。仅在 .course-row.done 上生效，明日课次无 done 故不受影响。 */
.course-row.done { opacity: 0.6; }
.course-row.done .course-name,
.course-row.done .course-time,
.course-row.done .course-room { color: #BFBFBF; }
.course-row.done .course-bar.on { background: #E5E6EB; }   /* 本人(isMine)蓝条也退回灰 */
.course-row.done .tag { background: #F2F3F5; color: #C9CDD4; }
