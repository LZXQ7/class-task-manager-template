
/**
 * P2 · 首页
 *
 * ⚠️ 开头这一段是**页面骨架**，整段没了页面会「编译通过但整页变样」：
 *    · `.wrap` —— 内容左右 32rpx 内边距；一没，卡片就满宽贴边；
 *    · `.hero*` —— 值日 Hero 卡；一没，Hero 退化成一行纯文字；
 *    · `.mt16` / `.nav-*` / `.foot-space` —— 卡片间距 / 导航栏中间 / 底部留白。
 * 给本文件追加样式时**一律加到文件末尾**，不要覆盖开头（2026-09-25 踩过一次，
 * 那次把这一段连同「发布通知」样式一起插到头部，结果整段被顶掉）。
 */

/* ---------- 布局骨架 ---------- */
/* 主内容滚动交给 spring-scroll（v0.7.19 需求④）；根不再原生滚动 */
.home { height: 100vh; overflow: hidden; display: flex; flex-direction: column; }
.home-scroll { display: block; }
.wrap { padding: 24rpx 32rpx; }
.mt16 { margin-top: 16rpx; }
.foot-space { height: 168rpx; }        /* 给固定 tabBar 让位，与全局 .page-foot-space 同值 */

/* ---------- NavBar 中间：日期 + 周次 ---------- */
.nav-center { display: flex; flex-direction: row; align-items: baseline; justify-content: center; }
.nav-date { font-size: 30rpx; font-weight: 600; color: #1D2129; }
.nav-week { margin-left: 8rpx; font-size: 22rpx; color: #86909C; }

/* ---------- Hero 值日卡 ----------
 * 状态变体（设计稿）：plain 白底 / blue 蓝渐变（进行中）/ leave 橙底（已请假）/ small 无值日。
 * 主文案与副文案的**颜色不写在这里** —— 由 JS 按状态内联 hero.titleColor / hero.subColor
 * 下发，因为同一句话在白底卡和蓝底卡上要换色。 */
.hero {
  position: relative;
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 40rpx;                 /* 设计稿：Hero 卡 16pt 圆角（普通卡片是 12pt = 24rpx） */
  /* 玻璃材质，与全站卡片统一（v0.7.19 需求③）；plain / small 走玻璃，blue / leave 仍是实色 */
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-edge);
  box-shadow: var(--glass-shadow), var(--glass-highlight);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  overflow: hidden;
}
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .hero { background: rgba(255, 255, 255, 0.9); }
}
@media (prefers-reduced-transparency: reduce) {
  .hero { background: #FFFFFF; -webkit-backdrop-filter: none; backdrop-filter: none; }
}
.hero:active { opacity: 0.94; }
.hero.blue {
  background: linear-gradient(135deg, #3370FF 0%, #5A8CFF 100%);
  border-color: transparent;
  box-shadow: 0 8rpx 32rpx rgba(51,112,255,0.28);
}
.hero.leave { background: #FFF7E8; border-color: #FFF3C2; }
/* 无值日：白底小卡；不带头部状态行，标题上边距在 .noduty 里归零 */
.hero.small { padding: 30rpx 32rpx; }

.hero-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.hero-chip {
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.20);
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 44rpx;
}
/* 白底 / 橙底卡上白胶囊看不见 → 换成浅灰底深字 */
.hero.plain .hero-chip,
.hero.small .hero-chip,
.hero.leave .hero-chip { background: #F2F3F5; color: #4E5969; }
.hero-chip.right { display: flex; flex-direction: row; align-items: center; }
.hero-dot {
  width: 16rpx;
  height: 16rpx;
  margin-left: 10rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
}

.hero-title { margin-top: 20rpx; font-size: 44rpx; line-height: 60rpx; font-weight: 600; }
.hero-sub { margin-top: 8rpx; font-size: 26rpx; line-height: 34rpx; }

.hero-bottom {
  margin-top: 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.hero-peers { display: flex; flex-direction: row; align-items: center; }
.hero-peer + .hero-peer { margin-left: -16rpx; }   /* 叠放姓名牌，重叠 8pt */
.hero-peer-text { margin-left: 24rpx; font-size: 24rpx; color: rgba(255, 255, 255, 0.70); }
.hero.plain .hero-peer-text,
.hero.small .hero-peer-text,
.hero.leave .hero-peer-text { color: #86909C; }
.hero-more { font-size: 24rpx; }       /* 颜色随 hero.subColor 内联 */

/* 无值日变体的两行文案 */
.hero-title.noduty { margin-top: 0; font-size: 40rpx; line-height: 56rpx; color: #1D2129; }
.hero-sub.noduty-sub { margin-top: 8rpx; font-size: 26rpx; line-height: 36rpx; color: #86909C; }

/* ============================================================
 * 以下为功能弹层 / 列表样式，追加在骨架之后
 * ============================================================ */

/* ============ 发布通知（管理员） ============
 * 2026-09-25 统一 UI：原来 .np 没有左右内边距 → 表单直接贴屏幕边、看着很挤（用户反馈）。
 * 现在统一为：左右 32rpx（与页面其它卡片一致）、每个 .np-field 之间 28rpx、
 * 标签 26rpx #4E5969 + 可选「选填」小灰字，输入控件一律 92rpx / 圆角 16rpx / #F7F8FA 底。
 * ⚠️ segmented 的 width 参数写死 686rpx = 750 - 32*2，改这里的内边距必须同步改 wxml。 */
.np { padding: 8rpx 32rpx 40rpx; }
.np-field { margin-top: 28rpx; }
.np-field:first-child { margin-top: 4rpx; }

.np-label {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #4E5969;
}
.np-opt {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: #86909C;
}

.np-input {
  height: 92rpx;
  padding: 0 24rpx;
  background: #F7F8FA;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #1D2129;
  box-sizing: border-box;
}
.np-input-2 { margin-top: 12rpx; }
.np-link-detecting {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #86909C;
  line-height: 32rpx;
}
.np-textarea {
  width: 100%;
  height: 240rpx;
  padding: 22rpx 24rpx;
  background: #F7F8FA;
  border-radius: 32rpx;
  font-size: 28rpx;
  line-height: 44rpx;
  color: #1D2129;
  box-sizing: border-box;
}

/* 「指定成员」的搜索 + 名单，整体收进一块浅底面板，跟上面的输入控件区分开 */
.np-panel {
  padding: 20rpx 20rpx 8rpx;
  background: #F5F6F8;
  border: 2rpx solid #F2F3F5;
  border-radius: 32rpx;
}
/* §42 隔离提示：picker 顶部说明「测试账号与辅导员不接收」—— 避免用户疑惑「为什么看不到 XX」 */
.np-pick-hint {
  padding: 0 8rpx 16rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #86909C;
}
.np-search {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 72rpx;
  padding: 0 20rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
}
.np-search-input {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #1D2129;
}
.np-picked { margin-left: 8rpx; font-size: 24rpx; color: #3370FF; }
/* 一键选组（需求④）：A / B / 清空 */
.np-abtns {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 16rpx;
}
.np-abtn {
  margin: 0 12rpx 12rpx 0;
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #3370FF;
  background: #DCE8FF;
  border-radius: 999rpx;
}
.np-abtn.ghost { color: #4E5969; background: #FFFFFF; border: 2rpx solid #E5E6EB; }
.np-abtn.on { color: #FFFFFF; background: #3370FF; padding: 0 34rpx; }
.np-abtn-hover { opacity: 0.7; }
/* 小图形网格：每个成员一个头像圆点（显示序号），比长列表紧凑得多（需求④）。
   ⚠️ scroll-y 必须给显式 height（max-height 不算，check-count-align ①-b），
   否则滚不动、手势穿透到后面的页面 */
.np-grid-scroll {
  margin-top: 16rpx;
  height: 560rpx;
  box-sizing: border-box;
}
.np-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}
.np-cell {
  width: 96rpx;
  margin: 0 12rpx 16rpx 0;
  padding: 12rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 32rpx;
  box-sizing: border-box;
}
/* 成员网格是**固定 96rpx 宽**的头像格（border-box，改 padding 不改外宽），
   所以它只吃 .chip-motion.on 的轻微顶起（scale 1.04），不参与「挤开」——
   强行让 50+ 个格子逐个改宽度会整片重排，低端机点一下卡一下。 */
.np-cell.on { background: #DCE8FF; }
.np-cell-hover { background: #F2F3F5; }
.np-cell-name {
  margin-top: 8rpx;
  max-width: 96rpx;
  font-size: 20rpx;
  line-height: 26rpx;
  color: #4E5969;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.np-switch {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx;
  background: #F7F8FA;
  border-radius: 32rpx;
}
.np-switch-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.np-switch-title { font-size: 28rpx; color: #1D2129; }
.np-switch-sub { margin-top: 6rpx; font-size: 22rpx; line-height: 32rpx; color: #86909C; }

.np-actions { display: flex; flex-direction: row; margin-top: 40rpx; }
.np-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 32rpx;
  font-size: 28rpx;
  /* 发布/取消按钮按下反馈（v0.7.14 · #4/#5①）：缩放 + 淡入回弹，点下去「实」一点 */
  transition: opacity .1s ease, transform .1s ease;
}
.np-btn.ghost { flex: 0 0 200rpx; background: #F2F3F5; color: #4E5969; margin-right: 16rpx; }
.np-btn.primary { background: #3370FF; color: #FFFFFF; font-weight: 600; }
.np-btn.primary.off { background: #A8C1FF; }
.np-btn:active { opacity: 0.85; transform: scale(0.975); }

/* ---------- 配图（v0.7.14） ---------- */
.np-imgs {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}
.np-img {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: #F2F3F5;
}
.np-img-pic { width: 100%; height: 100%; display: block; }
.np-img-x {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}
.np-img-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #C9CDD4;
  color: #86909C;
  font-size: 22rpx;
  gap: 4rpx;
}
.np-img-add-t { margin-top: 2rpx; }

/* ---------- 语音条 ---------- */
.voice-bar {
  background: #F0F5FF;
  border-radius: 40rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}
.voice-ic {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}
.voice-info { flex: 1; margin-left: 24rpx; min-width: 0; }
.voice-title { font-size: 28rpx; color: #245BDB; }
.voice-sub { margin-top: 4rpx; font-size: 24rpx; color: #86909C; }
.voice-btn {
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
