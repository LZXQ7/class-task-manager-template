  line-height: 64rpx;
}

/* ---------- 卡片 ---------- */
/* 卡片统一用全局玻璃材质（app.wxss .card）；本页不再覆写成纯白（v0.7.19 需求③） */
.card-head {
  height: 88rpx;
  padding: 0 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #F2F3F5;
}
.card-title { font-size: 30rpx; font-weight: 600; color: #1D2129; }
.card-link { font-size: 26rpx; color: #3370FF; }
.card-sub { font-size: 24rpx; color: #86909C; }

/* ---------- 课次行 ---------- */
.course-row {
  position: relative;
  padding: 16rpx 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  border-bottom: 2rpx solid #F2F3F5;
}
.course-row:last-child { border-bottom: none; }
.course-row.mine { background: #F7F8FA; }
.course-bar {
  position: absolute;
  left: 32rpx;
  top: 24rpx;
  width: 6rpx;
  height: 64rpx;
  border-radius: 3rpx;
  background: #E5E6EB;
}
.course-bar.on { background: #3370FF; }
.course-info { margin-left: 24rpx; flex: 1; min-width: 0; }
.course-line1 { display: flex; flex-direction: row; align-items: center; }
.course-time { font-size: 24rpx; color: #86909C; margin-right: 16rpx; }
.course-name { font-size: 30rpx; color: #1D2129; }
.course-room { margin-top: 4rpx; font-size: 24rpx; color: #86909C; }
.tag {
  flex-shrink: 0;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  line-height: 40rpx;
}
.tag.ga { background: #F0F5FF; color: #3370FF; }
.tag.gb { background: #F3F0FF; color: #7C5CFF; }
.tag.all { background: #F2F3F5; color: #4E5969; }
.no-course {
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #86909C;
}

/* ---------- 快捷入口已下线（.quick / .quick-item 一并删除） ---------- */

/* ---------- 提醒卡 ---------- */
.remind {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 32rpx;
}
.remind-info { flex: 1; margin-left: 24rpx; }
.remind-title { font-size: 30rpx; color: #1D2129; }
.remind-sub { margin-top: 4rpx; font-size: 24rpx; color: #86909C; }
.remind-done {
