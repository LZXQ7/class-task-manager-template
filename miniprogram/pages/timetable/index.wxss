.tt { min-height: 100vh; }
.tt-nav-right { display: flex; align-items: center; }
.tt-nav-btn { font-size: 30rpx; color: #3370FF; padding: 0 16rpx; }

/* 课表管理工具条（导入课表 / 适配申请）
   ⚠️ 这两个入口从导航栏移到这里的原因：nav-bar 标题是**居中定宽**的，
      右侧堆 3 个文字按钮会把居中的「课表」标题挤掉（真机已复现）。
   样式沿用项目胶囊语言（半透明品牌底 + 品牌色文字），与值日页 .dt-modebar 胶囊同源。 */
.tt-tools {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 32rpx 16rpx;
}
.tt-tool-btn {
  font-size: 26rpx;
  color: #3370FF;
  background: rgba(51, 112, 255, 0.08);
  border: 1rpx solid rgba(51, 112, 255, 0.18);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  line-height: 1.4;
  /* ⚠️ 按钮多时 flex 会压缩每个 item，文字逐字换行成「竖排」（2026-10-06 真机踩坑）。
     nowrap + flex-shrink:0 双保险：宁可整体省略号/超出，也不许文字竖排。 */
  white-space: nowrap;
  flex-shrink: 0;
}

.tt-wrap { padding: 0 32rpx; }

/* ---------- 骨架屏（loading 态沿用旧的 5 行结构） ---------- */
.tt-time {
  width: 86rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.tt-head .tt-time { height: 80rpx; }
.tt-time-p { font-size: 26rpx; font-weight: 600; color: #1D2129; }
/* .tt-time-t（节次下的上课时间）已按要求去掉，只留「1-5」节次号 */
.tt-cells {
  flex: 1;
  display: flex;
  flex-direction: row;
}
.tt-grid { padding: 0 32rpx; }

/* ---------- 课表主体：左「节次」列固定 + 右侧横向滚动 ----------
 * 宽度账：一屏 750rpx − 左右留白 64rpx = 686rpx；
 *         左列 86rpx，右侧可视 600rpx，正好 5 列 × 120rpx（周一至周五）；
 *         第 6、7 列（周六 / 周日）落在滚动区右侧，滑动才能看到。
 * ⚠️ 这个 120rpx 必须与 index.js 里的 COL_W 一致，否则表头与格子错位。 */
.tt-board {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 0 32rpx;
}
.tt-fixed { width: 86rpx; flex-shrink: 0; }
.tt-fixed-head { height: 72rpx; }
.tt-fixed-row {
  /* 行高由 JS 按屏幕高度内联下发（自适应），这里只留兜底值 */
  height: 132rpx;
  border-top: 2rpx solid #F2F3F5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.tt-scroll { flex: 1; min-width: 0; }
.tt-body { display: inline-block; }

.tt-scroll-hint {
  text-align: center;
  font-size: 22rpx;
  color: #C9CDD4;
  padding: 16rpx 0 0;
}

/* ---------- 表头 ---------- */
/* 列宽不写死：.tt-body 用内联 width 定总宽，列用 flex:1 等分 —— 天数变化时自动适配 */
.tt-head { display: flex; flex-direction: row; width: 100%; }
.tt-row {
  display: flex;
  flex-direction: row;
  width: 100%;
  border-top: 2rpx solid #F2F3F5;
}
.tt-head-cell {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
}
/* 周末底色：用极淡的品牌蓝「磨砂」叠在极光上，既区别于工作日、又不会像旧版中性灰那样
   在极光背景上冒出一块「白块」。.today 写在后面，同优先级下后者覆盖前者 */
.tt-head-cell.wk { background: rgba(51, 112, 255, 0.12); }
.tt-head-cell.today { background: #F0F5FF; }
.tt-head-w { font-size: 26rpx; color: #4E5969; }
.tt-head-cell.today .tt-head-w { color: #3370FF; font-weight: 600; }
.tt-head-d { font-size: 24rpx; color: #86909C; margin-top: 2rpx; }

/* ---------- 网格 ---------- */
.tt-cell-slot {
  flex: 1;
  min-width: 0;
  height: 100%;      /* 行高由 JS 内联下发，格子撑满所在行 */
  padding: 2rpx;
  position: relative;
  display: flex;
  flex-direction: column;
}
/* 空的周末格子给一层浅底，让人一眼看出「这两天是周末」，可往这里排调休课。
   用品牌蓝磨砂（非中性灰），避免在极光背景上形成刺眼的白块 */
.tt-cell-slot.wk { background: rgba(51, 112, 255, 0.08); }
.tt-cell {
  flex: 1;
  min-height: 56rpx;
  border-radius: 24rpx;
  padding: 6rpx 8rpx;
  margin-bottom: 2rpx;
  position: relative;
  overflow: hidden;
}
/* 空格子占位（无课） */
.tt-cell.empty {
  background: transparent;
  border: 1rpx dashed #E5E6EB;
}
.tt-cell-name {
  font-size: 22rpx;
  font-weight: 500;
  line-height: 28rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.tt-cell-room {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  font-size: 20rpx;
  opacity: 0.6;
}
/* A/B 组标签：放在课程名前，独占一行，不再绝对定位遮挡课程名 */
.tt-cell-tag {
  display: inline-block;
  height: 24rpx;
  padding: 0 6rpx;
  margin-bottom: 4rpx;
  border-radius: 4rpx;
  background: rgba(51,112,255,0.12);
  font-size: 18rpx;
  line-height: 24rpx;
  color: #3370FF;
  font-weight: 600;
}
.tt-foot { height: 48rpx; }

/* ---------- FAB ---------- */
/* 新增课次「＋」：右下角。高度自适应后课表已占满屏，浮动按钮贴身底部即可。
 * bottom 让开悬浮胶囊 tabBar（占位 98rpx）+ 安全区。 */
.fab {
  position: fixed;
  right: 32rpx;
  /* 让开悬浮胶囊 tabBar（占位 98rpx）+ 安全区；无安全区机型兜底 32px（同 TABBAR_LIFT_PX）。
     前一行是回退：引擎不认 max() 时整条声明被丢弃。 */
  bottom: calc(138rpx + env(safe-area-inset-bottom));
  bottom: calc(138rpx + max(env(safe-area-inset-bottom), 32px));
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  /* 主操作 FAB = 品牌色玻璃（v0.7.17）：仍以品牌蓝为主色（白色「＋」的可读性靠 tint 保底），
     只把实心蓝换成「半透明蓝 + 模糊 + 顶部高光」，与其余玻璃面同一套语汇。 */
  background: rgba(51,112,255,0.84);
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  backdrop-filter: blur(24px) saturate(160%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 22rpx rgba(51,112,255,0.28), inset 0 1rpx 0 rgba(255, 255, 255, 0.45);
  z-index: 700;
}
.fab:active { background: rgba(36,91,219,0.9); }

/* 临时调课：左下角胶囊（超管）。与右侧「＋」分列两边，互不遮挡。 */
/* ---------- 左下角视图入口（v0.7.21 需求③） ----------
 * 原先是「顶部 A/B 分段 + 左下角『临时调课』胶囊」两处入口，现在合并成一个：
 * 按钮上写着当前正在看的组，点开向上展开 A 组 / B 组 / 临时调课。
 * ⚠️ fixed 元素：必须留在 .wk-swipe 动画容器外面（transform 建包含块），由 check-tab-enter 守着。
 * ⚠️ 展开/收起只用 opacity + transform 过渡（不写 animation）：随时能反着播，不会被「点了没反应」。 */
.fab-menu {
  position: fixed;
  left: 32rpx;
  /* 同 .fab：让开悬浮胶囊 tabBar + 安全区；无安全区机型兜底 32px（前一行回退） */
  bottom: calc(144rpx + env(safe-area-inset-bottom));
  bottom: calc(144rpx + max(env(safe-area-inset-bottom), 32px));
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  z-index: 700;
}
.fab-menu-btn {
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 42rpx;
  background: rgba(255, 255, 255, 0.50);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  backdrop-filter: blur(24px) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  display: flex;
  flex-direction: row;
  align-items: center;
  box-shadow: 0 6rpx 22rpx rgba(51,112,255,.18), inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}
.fab-menu-t {
  font-size: 26rpx;
  font-weight: 600;
  color: #3370FF;
  margin: 0 6rpx 0 8rpx;
}
/* 收起态：整体下移 12rpx + 透明 + 不接点击；展开态回到原位。
   两态之间是同一个 transition，所以「展开到一半再点一下」能立刻反向，不会卡住。 */
.fab-menu-list {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 16rpx;
  opacity: 0;
  transform: translateY(12rpx);
  pointer-events: none;
  transition: opacity .18s ease, transform .22s cubic-bezier(.22, .61, .36, 1);
}
.fab-menu.open .fab-menu-list {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}
.fab-menu-item {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 30rpx;
  margin-top: 12rpx;
  border-radius: 38rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #4E5969;
  background: rgba(255, 255, 255, 0.62);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  backdrop-filter: blur(24px) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 6rpx 20rpx rgba(51,112,255,.14), inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}
/* 当前正在看的那一组：品牌渐变实心，一眼能看出「现在看的是谁」 */
.fab-menu-item.on {
  color: #FFFFFF;
  background: linear-gradient(135deg, #7C5CFF 0%, #3370FF 100%);
}
.fab-menu-item:active { opacity: 0.85; }
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .fab-menu-btn { background: rgba(255, 255, 255, 0.93); }
  .fab-menu-item { background: rgba(255, 255, 255, 0.95); }
}
@media (prefers-reduced-transparency: reduce) {
  .fab-menu-btn {
    background: #FFFFFF;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .fab-menu-item {
    background: #FFFFFF;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
}
@media (prefers-reduced-motion: reduce) {
  .fab-menu-list { transition: opacity .12s linear; transform: none; }
  .fab-menu.open .fab-menu-list { transform: none; }
}
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .fab { background: #3370FF; }
}
@media (prefers-reduced-transparency: reduce) {
  .fab {
    background: #3370FF;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
}

/* ---------- 详情 / 表单 ---------- */
.ds-form { padding: 8rpx 32rpx 48rpx; }
.tt-detail-name { font-size: 34rpx; font-weight: 600; color: #1D2129; margin-bottom: 16rpx; }
.tt-detail-row {
  display: flex;
  flex-direction: row;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #F2F3F5;
}
.tt-detail-row .k { width: 140rpx; font-size: 26rpx; color: #86909C; }
.tt-detail-row .v { flex: 1; font-size: 26rpx; color: #1D2129; }
.tt-detail-duties { margin-top: 24rpx; }
.tt-detail-sub { font-size: 26rpx; color: #4E5969; margin-bottom: 12rpx; }
.tt-duty-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 0;
}
.tt-duty-name { margin: 0 16rpx; flex: 1; font-size: 28rpx; color: #1D2129; }
.tt-detail-actions {
  display: flex;
  flex-direction: row;
  margin-top: 32rpx;
}
.tt-dbtn {
  height: 88rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin-right: 16rpx;
  padding: 0 32rpx;
}
.tt-dbtn.danger { background: #FFECE8; color: #F53F3F; }
.tt-dbtn.primary { flex: 1; background: #3370FF; color: #FFFFFF; font-weight: 600; margin-right: 0; }

.f-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 112rpx;
  border-bottom: 2rpx solid #F2F3F5;
}
.f-label { width: 180rpx; font-size: 30rpx; color: #1D2129; flex-shrink: 0; }
.f-input {
  flex: 1;
  height: 96rpx;
  font-size: 30rpx;
  color: #1D2129;
  text-align: right;
}
.f-ph { color: #C9CDD4; font-size: 28rpx; }
.f-block { padding: 16rpx 0; border-bottom: 2rpx solid #F2F3F5; }
.f-chips { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 12rpx; }
/* ⚠️ 两条为了让「挤开动画」真的平滑而加的改动：
   ① box-sizing: border-box —— 否则 .on 多出来的 2rpx 边框会把盒子撑大 4rpx，
      选中瞬间整行高度抖一下（边框只能过渡颜色，不能过渡「有没有」）；
   ② 默认就挂一圈 transparent 边框 —— 选中时只换 border-color，不再凭空长出边框。 */
.f-chip {
  height: 64rpx;
  padding: 0 24rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 32rpx;
  background: #F2F3F5;
  color: #4E5969;
  font-size: 26rpx;
  line-height: 64rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}
/* .on 补的 padding 是「挤开动画」的目标值（0 24rpx → 0 34rpx），
   过渡由 app.wxss 的 .chip-motion 负责 → 邻项平滑让位而不是瞬移 */
.f-chip.on {
  background: #F0F5FF;
  color: #3370FF;
  font-weight: 600;
  border: 2rpx solid #3370FF;
  padding: 0 34rpx;
}
/* 「当前正在看的那一周」只变色不加边框，与「已选中」区分开 */
.f-chip.cur { color: #3370FF; }
.f-tip { font-size: 24rpx; color: #86909C; }
/* 底部操作按钮统一规范（2026-10-05 修复「按钮堆叠 / 尺寸圆角字号不一致」）
   与全局 .btn 对齐：高度 96rpx、圆角 --r-md(32rpx)、字号 32rpx、字重 600。
   .f-actions 必须是 flex 行 + gap；主按钮 .f-save、次按钮 .im-cancel 等宽。
   以后加按钮直接套这套，不要再手写不一致的尺寸 / 圆角 / 字号。 */
.f-actions { display: flex; gap: 20rpx; align-items: stretch; margin-top: 32rpx; padding-bottom: 24rpx; }
.f-save, .im-cancel {
  flex: 1;
  height: 96rpx;
  border-radius: var(--r-md);
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.f-save { background: var(--brand); color: #FFFFFF; }
.f-save.off { background: var(--brand-disable); }
.im-cancel { background: #F2F3F5; color: #4E5969; font-weight: 500; }

/* ---------- 青果导入 / 申请适配（需求 D-2） ---------- */
.tt-import-card {
  margin: 48rpx 32rpx 0;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(29, 33, 41, 0.06);
}
.tt-import-title { font-size: 32rpx; font-weight: 600; color: #1D2129; }
.tt-import-desc { font-size: 26rpx; color: #86909C; margin-top: 12rpx; line-height: 38rpx; }
.tt-import-btn {
  margin-top: 28rpx;
  background: #3370FF;
  color: #FFFFFF;
  font-size: 30rpx;
  text-align: center;
  border-radius: 24rpx;
  padding: 22rpx 0;
}
.tt-import-btn.off { opacity: 0.5; }
/* 导入预览（与超管适配页共用一套 im-* 样式） */
.im-stat { display: flex; align-items: baseline; font-size: 28rpx; color: #4E5969; }
.im-num { font-size: 44rpx; font-weight: 700; color: #1D2129; margin: 0 6rpx; }
.im-dot { margin: 0 16rpx; color: #C9CDD4; }
.im-warn { margin-top: 24rpx; background: #FFF7E8; border-radius: 20rpx; padding: 20rpx 24rpx; }
.im-warn-t { font-size: 26rpx; color: #D25F00; font-weight: 600; }
.im-warn-item { font-size: 24rpx; color: #8A5A00; margin-top: 10rpx; line-height: 34rpx; }
.im-list-t { font-size: 26rpx; color: #86909C; margin: 28rpx 0 12rpx; }
/* ⚠️ 必须用 scroll-view（wxml 里）而不是「view + max-height」：
   view 只有高度限制、没有滚动容器，内容会溢出并压住底部按钮（2026-10-05 真机反馈）。 */
.im-list { height: 420rpx; }
.im-empty { font-size: 26rpx; color: #86909C; text-align: center; padding: 60rpx 0; }
.im-course { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; border-bottom: 2rpx solid #F2F3F5; }
.im-c-name { font-size: 28rpx; color: #1D2129; }
.im-c-teacher { font-size: 24rpx; color: #86909C; }
/* 本次导入的组别（2026-10-05） */
.im-group { margin-top: 16rpx; font-size: 26rpx; color: #4E5969; }
.im-group-v { color: #3370FF; font-weight: 600; }

/* ---------- 组别选择（导入 / 申请适配 共用，2026-10-05） ---------- */
.gp-tip { font-size: 25rpx; color: #4E5969; line-height: 38rpx; }
.gp-tip-sub { margin-top: 12rpx; color: #86909C; font-size: 24rpx; }
.gp-list { margin-top: 24rpx; }
.gp-item { background: #F7F8FA; border-radius: 24rpx; padding: 26rpx 28rpx; margin-bottom: 18rpx; }
.gp-item-t { font-size: 30rpx; color: #1D2129; font-weight: 600; }
.gp-item-d { font-size: 24rpx; color: #86909C; margin-top: 8rpx; }

/* ---------- 周次选择 ---------- */
.wk-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 8rpx 32rpx 32rpx;
}
.wk-chip {
  width: 148rpx;
  height: 96rpx;
  margin: 0 12rpx 16rpx 0;
  border-radius: 32rpx;
  background: #F2F3F5;
  color: #4E5969;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 同 .f-chip：默认挂透明边框 + border-box，选中时不凭空长边框、盒子不抖 */
  box-sizing: border-box;
  border: 2rpx solid transparent;
}
.wk-chip:nth-child(4n) { margin-right: 0; }
.wk-chip.cur { color: #3370FF; }
.wk-chip.on {
  background: #F0F5FF;
  color: #3370FF;
  font-weight: 600;
  border: 2rpx solid #3370FF;
}

/* ---------- 节假日 / 调休标记 ---------- */
.tt-head-cell.off { background: #FFF3F3; position: relative; }
.tt-head-cell.off .tt-head-w,
.tt-head-cell.off .tt-head-d { color: #F53F3F; }
.tt-head-tag {
  position: absolute;
  right: 6rpx;
  top: 4rpx;
  height: 24rpx;
  padding: 0 6rpx;
  border-radius: 4rpx;
  background: #F53F3F;
  color: #FFFFFF;
  font-size: 18rpx;
  line-height: 24rpx;
}
.tt-head-tag.mk { background: #FF7D00; }
.tt-head-shift {
  position: absolute;
  left: 6rpx;
  top: 4rpx;
  font-size: 18rpx;
  line-height: 22rpx;
  padding: 0 5rpx;
  border-radius: 4rpx;
  font-weight: 600;
}
.tt-head-shift.out { background: #FFF7E8; color: #FF7D00; }
.tt-head-shift.in { background: #D6E0FF; color: #3370FF; }
.tt-cell-shift {
  position: absolute;
  right: 4rpx;
  top: 4rpx;
  max-width: 116rpx;
  padding: 0 6rpx;
  border-radius: 4rpx;
  font-size: 18rpx;
  line-height: 24rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.tt-cell-shift.out { background: #FFF7E8; color: #FF7D00; }
.tt-cell-shift.in { background: #D6E0FF; color: #3370FF; }
/* 放假也照常显示课次，仅打「假期」标记（见 timetable.js sessionsOfWeek 的 isHoliday） */
.tt-cell.holiday {
  box-shadow: inset 0 0 0 200rpx rgba(134, 144, 156, 0.16);
  border-left: 6rpx solid #F53F3F;
}
/* 按天「调入」的课：左侧蓝色条，一眼看出是别处调来的 */
.tt-cell.moved-in {
  border-left: 6rpx solid #3370FF;
}
.tt-cell-holiday {
  position: absolute;
  right: 4rpx;
  top: 4rpx;
  height: 24rpx;
  padding: 0 6rpx;
  border-radius: 4rpx;
  background: #F53F3F;
  color: #FFFFFF;
  font-size: 18rpx;
  line-height: 24rpx;
  font-weight: 600;
  z-index: 2;
}

/* ---------- 校历弹层 ---------- */
.cal-sec { padding: 8rpx 0 24rpx; border-bottom: 2rpx solid #F2F3F5; }
.cal-sec:last-child { border-bottom: none; }
.cal-sec-t { font-size: 28rpx; font-weight: 600; color: #1D2129; padding: 8rpx 0 12rpx; }
.cal-list { padding-bottom: 4rpx; }
.cal-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #F7F8FA;
}
.cal-date { width: 210rpx; font-size: 26rpx; color: #1D2129; }
.cal-name { flex: 1; font-size: 26rpx; color: #4E5969; }
.cal-kind {
  font-size: 22rpx;
  color: #F53F3F;
  background: #FFF3F3;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  margin-right: 16rpx;
}
.cal-kind.mk { color: #FF7D00; background: #FFF7E8; }
.cal-del { font-size: 26rpx; color: #86909C; padding: 0 8rpx; }
.cal-empty { font-size: 26rpx; color: #C9CDD4; padding: 20rpx 0; text-align: center; }
.cal-form { margin-top: 16rpx; }
.cal-two { display: flex; flex-direction: row; align-items: center; }
.cal-picker {
  height: 80rpx;
  padding: 0 20rpx;
  border-radius: 32rpx;
  background: #F2F3F5;
  color: #1D2129;
  font-size: 28rpx;
  line-height: 80rpx;
  margin-right: 16rpx;
}
.cal-picker.ph { color: #C9CDD4; }
.cal-arrow { font-size: 30rpx; color: #86909C; margin-right: 16rpx; }
.cal-input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  border-radius: 32rpx;
  background: #F2F3F5;
  font-size: 28rpx;
  color: #1D2129;
  margin: 16rpx 0 0;
}
.cal-two .cal-input { margin: 0; }
.cal-save {
  height: 88rpx;
  margin-top: 20rpx;
  border-radius: 32rpx;
  background: #3370FF;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cal-hint { font-size: 24rpx; color: #86909C; margin-top: 12rpx; }

/* ---------- 临时调课弹层 ---------- */
.ts-pick {
  height: 88rpx;
  padding: 0 20rpx;
  border-radius: 32rpx;
  background: #F2F3F5;
  color: #1D2129;
  font-size: 28rpx;
  line-height: 88rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ts-pick.ph { color: #C9CDD4; }

/* 「这几天不上」的日期格：一行 7 个（周一至周日） */
.ts-days { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 12rpx; }
.ts-day {
  width: 88rpx;
  height: 104rpx;
  margin: 0 8rpx 12rpx 0;
  border-radius: 32rpx;
  background: #F2F3F5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.ts-day:nth-child(7n) { margin-right: 0; }
.ts-day.on { background: #FFF3F3; border: 2rpx solid #F53F3F; }
.ts-day-w { font-size: 24rpx; color: #86909C; }
.ts-day-d { font-size: 28rpx; font-weight: 600; color: #1D2129; margin-top: 4rpx; }
.ts-day.on .ts-day-w, .ts-day.on .ts-day-d { color: #F53F3F; }

.ts-area {
  width: 100%;
  box-sizing: border-box;
  min-height: 180rpx;
  padding: 20rpx;
  margin-top: 12rpx;
  border-radius: 32rpx;
  background: #F7F8FA;
  font-size: 28rpx;
  color: #1D2129;
  line-height: 40rpx;
}
.ts-area.tall { min-height: 480rpx; }

.ts-chips { display: flex; flex-direction: column; margin-top: 12rpx; }
.ts-chip {
  font-size: 26rpx;
  color: #3370FF;
  background: #F0F5FF;
  border-radius: 24rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 12rpx;
}

.ts-row { display: flex; flex-direction: row; margin-top: 20rpx; }
.ts-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}
.ts-btn + .ts-btn { margin-left: 16rpx; }
.ts-btn.primary { background: #3370FF; color: #FFFFFF; }
.ts-btn.primary.off { background: #A8C1FF; }
.ts-btn.ghost { background: #F2F3F5; color: #4E5969; font-weight: 500; }
.ts-btn.ghost.danger { background: #FFECE8; color: #F53F3F; }

.ts-err {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 24rpx;
  background: #FFECE8;
  color: #F53F3F;
  font-size: 24rpx;
  line-height: 36rpx;
}
.ts-note { font-size: 26rpx; color: #4E5969; padding: 8rpx 0 12rpx; }

.ts-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #F7F8FA;
}
.ts-item-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.ts-item-name {
  font-size: 28rpx;
  color: #1D2129;
  font-weight: 500;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ts-item-eff { font-size: 24rpx; color: #86909C; margin-top: 6rpx; }
.ts-item-note { font-size: 22rpx; color: #C9CDD4; margin-left: 16rpx; max-width: 220rpx; }
.ts-warn { font-size: 24rpx; color: #FF7D00; line-height: 36rpx; padding: 4rpx 0; }
.ts-del { font-size: 26rpx; color: #F53F3F; padding: 8rpx 0 8rpx 16rpx; }

/* 课格按压反馈：cell 背景是内联 style（按课程着色），tap-hover 加底色会被盖住，
   用整体轻微变暗代替；只动 opacity，不建包含块（页面有 FAB fixed 元素）。 */
.tt-cell-hover { opacity: .78; }

/* 辅导员空态（2026-09-26 需求⑧）：课表暂时清空，等学校教务系统接入 */
.tt-empty {
  margin: 120rpx 48rpx 0;
  padding: 56rpx 40rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.tt-empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
}
.tt-empty-desc {
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 40rpx;
  color: #86909C;
  text-align: center;
}

/* ================================================================
   我的课表（2026-10-06，页内实现，不跳独立页）
   ------------------------------------------------------------
   数据源切换 tab 与工具条合并在 .tt-panel 这**一个** .st-item 槽位里
   （入场动画档位必须严格递增 1→2→3，check-tab-enter 守）。
   ⚠️ 追加本段时用 Read+Edit，**不要用 `cat >>` heredoc** ——
      2026-10-06 用 heredoc 追加把本文件截断成 713 行（原 740），
      .tt-board/.tt-tools 等原有样式全丢，check-wxss 判「用了但没定义」19 个类。
      heredoc 追加大段 CSS 到既有文件不可靠，改用 Edit。
   ================================================================ */
.tt-panel { padding: 0 24rpx; }
.tt-src {
  display: flex; background: rgba(255, 255, 255, 0.7);
  border-radius: var(--r-pill, 999rpx); padding: 6rpx; margin-bottom: 16rpx;
}
.tt-src-item {
  flex: 1; text-align: center; font-size: 28rpx; color: #4E5969;
  padding: 14rpx 0; border-radius: var(--r-pill, 999rpx); transition: all .2s;
}
.tt-src-item.on { background: var(--brand, #3370FF); color: #fff; font-weight: 600; }

/* 弹层里的星期 / 节次 / 周次选择 chips */
.mt-chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.mt-chip {
  padding: 14rpx 28rpx; border-radius: var(--r-pill, 999rpx);
  background: #F2F3F5; font-size: 25rpx; color: #4E5969;
}
.mt-chip.on { background: rgba(51, 112, 255, 0.12); color: var(--brand, #3370FF); font-weight: 600; }
.mt-weeks { margin-top: 16rpx; }

/* 导入说明 / 预览 */
.mt-guide { padding: 8rpx 8rpx 24rpx; }
.mt-guide-t { font-size: 27rpx; color: #1D2129; font-weight: 600; margin-bottom: 10rpx; }
.mt-guide-s { font-size: 25rpx; color: #4E5969; line-height: 38rpx; }
.mt-stat { font-size: 25rpx; color: #4E5969; padding: 4rpx 8rpx; }
.mt-stat2 { margin-top: 8rpx; line-height: 38rpx; }
.mt-stat-b { color: #1D2129; font-weight: 600; }
.mt-warn-b { color: #D25F00; font-weight: 600; }
.mt-busy { text-align: center; font-size: 25rpx; color: #86909C; padding: 16rpx 0; }
.mt-warn-box { background: #FFF7E8; border-radius: 20rpx; padding: 20rpx; margin: 16rpx 8rpx; }
.mt-warn-t { font-size: 25rpx; color: #D25F00; font-weight: 600; }
.mt-warn-s { font-size: 23rpx; color: #8A5A00; margin-top: 8rpx; line-height: 34rpx; }
.mt-prev { height: 440rpx; margin: 16rpx 8rpx; }
.mt-prev-row { display: flex; align-items: baseline; padding: 12rpx 0; border-bottom: 1rpx solid rgba(0, 0, 0, 0.04); }
.mt-prev-d { font-size: 22rpx; color: #86909C; width: 150rpx; flex-shrink: 0; }
.mt-prev-n { font-size: 25rpx; color: #1D2129; flex: 1; }

/* 发布到全班（二次确认） */
.mt-pub { padding: 8rpx 8rpx 24rpx; }
.mt-pub-s { font-size: 26rpx; color: #4E5969; line-height: 38rpx; margin-top: 12rpx; }
.mt-pub-w {
  font-size: 24rpx; color: #8A5A00; background: #FFF7E8;
  border-radius: 20rpx; padding: 20rpx; margin-top: 20rpx; line-height: 36rpx;
}
.f-del { flex: 1; }
