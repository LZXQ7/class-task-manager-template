/* 过渡时长 .24s 与 popup-anim.js 的 DURATION 保持一致 */
.dlg-root {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1100;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 关闭动画期间节点仍在 DOM，用空壳兜住，别吞掉页面点击 */
  pointer-events: none;
}
.dlg-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0,0,0,0.45);
  opacity: 0;
  transition: opacity .24s ease;
}
.dlg-mask.in { opacity: 1; pointer-events: auto; }
.dlg-box {
  position: relative;
  width: 590rpx;
  /* 对话框 = 玻璃材质（v0.7.17）。圆角写在元素自己身上：
     `overflow:hidden` 裁不住 backdrop-filter，模糊层只认元素自身的 border-radius。 */
  background: rgba(255, 255, 255, 0.52);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  backdrop-filter: blur(24px) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(29,33,41,0.18), inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  padding: 48rpx 40rpx 0;
  text-align: center;
  opacity: 0;
  transform: scale(.92);
  transition: opacity .24s ease, transform .24s cubic-bezier(.22, .61, .36, 1);
}
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .dlg-box { background: rgba(255, 255, 255, 0.95); }
}
@media (prefers-reduced-transparency: reduce) {
  .dlg-box {
    background: #FFFFFF;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
}
.dlg-box.in { opacity: 1; transform: scale(1); pointer-events: auto; }
.dlg-icon {
  display: flex;
  justify-content: center;
  margin-bottom: 16rpx;
}
.dlg-title {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 600;
  color: #1D2129;
}
.dlg-content {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 42rpx;
  color: #4E5969;
}
.dlg-actions {
  margin-top: 40rpx;
  height: 104rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  border-top: 2rpx solid rgba(229,230,235,0.7);
}
.dlg-btn {
  flex: 1;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.dlg-cancel {
  color: #4E5969;
  border-right: 2rpx solid rgba(229,230,235,0.7);
}
.dlg-cancel:active { background: #F7F8FA; }
.dlg-confirm { font-weight: 600; }
.dlg-confirm:active { background: #F7F8FA; }
